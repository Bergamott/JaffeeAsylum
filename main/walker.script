go.property("type", 1)

WALK_SPEED = 40.0
VANISH_POINT = 750.0
WALK_ANIMATIONS = {hash("tall_walk"), hash("woman_walk"),
hash("short_walk"), hash("dude_walk"),
hash("tall_walk_white"), hash("woman_walk_white"),
hash("short_walk_white"), hash("dude_walk_white")}

function skewed_vector(angle)
	local ang = angle + 50.0*(math.random()-0.5)
	local x = math.cos(math.rad(ang))
	local y = math.sin(math.rad(ang))
	return vmath.vector3(x, y, 0)
end

function init(self)
	self.pos = go.get_position()
	sprite.play_flipbook("#sprite", WALK_ANIMATIONS[self.type])
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	self.pos.x = self.pos.x + dt * WALK_SPEED
	go.set_position(self.pos)
	if self.pos.x > VANISH_POINT then
		go.delete()
	end
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("collision_response") then
		local burst_pos = vmath.vector3(self.pos.x, self.pos.y+10.0, -0.5)
		local id = factory.create("game_area#burst_factory", self.pos, nil)
		go.set_parent(id, "/game_background", false)
		-- Hat
		local hat_pos = vmath.vector3(self.pos.x, self.pos.y+25.0, self.pos.z)
		id = factory.create("game_area#debris_factory", hat_pos, nil,
			{rotation = 300.0*(math.random()-0.5), dir = skewed_vector(90.0), 
			type = self.type + 1})
		go.set_parent(id, "/game_background", false)
		-- Legs
		local back_leg_pos = vmath.vector3(self.pos.x-10.0, self.pos.y-25.0, self.pos.z)
		id = factory.create("game_area#debris_factory", back_leg_pos, nil,
			{rotation = 300.0*(math.random()-0.5), dir = skewed_vector(240.0), 
			type = 1})
		go.set_parent(id, "/game_background", false)
		local front_leg_pos = vmath.vector3(self.pos.x+10.0, self.pos.y-25.0, self.pos.z)
		id = factory.create("game_area#debris_factory", front_leg_pos, nil,
			{rotation = 300.0*(math.random()-0.5), dir = skewed_vector(300.0), 
			type = 1})
		go.set_parent(id, "/game_background", false)
		go.delete()
	end
end

