RUNNING_SPEED = 80.0
SWING_INTERVAL = 0.45
HIT_START = 0.30
HIT_END = 0.15
MIN_Y = 80.0
MAX_Y = 320.0
MIN_X = 310.0
MAX_X = 700.0
NATURAL_X = 400.0

local function setup(self)
	self.pos = vmath.vector3(400.0, 200.0, 0)
	self.hit_countdown = 0.0
	self.v_dir = 0
	self.h_dir = 0
	self.facing_left = true
	self.leg_animation = hash("legs_stand_left")
	sprite.play_flipbook("#legs", self.leg_animation)
	self.body_animation = hash("body_left1")
	sprite.play_flipbook("#body", self.body_animation)
	msg.post("#left_baton", "disable")
	msg.post("#right_baton", "disable")
	self.baton_state = 0
	msg.post(".", "acquire_input_focus")    -- acquiring input focus
	self.active = true
end

function init(self)
	self.active = false
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	if self.active then
		self.hit_countdown = self.hit_countdown - dt

		local running = false
		local leg_animation = hash("legs_stand_left")
		local body_animation = self.body_animation
		if not self.facing_left then
			leg_animation = hash("legs_stand_right")
		end
		if self.h_dir == 3 then
			self.pos.x = self.pos.x - RUNNING_SPEED * dt;
			self.facing_left = true
			running = true
			leg_animation = hash("legs_left")
			if self.hit_countdown <= 0 then
				body_animation = hash("body_left1")
			end
		elseif self.h_dir == 4 then
			self.pos.x = self.pos.x + RUNNING_SPEED * dt;
			self.facing_left = false
			running = true
			leg_animation = hash("legs_right")
			if self.hit_countdown <= 0 then
				body_animation = hash("body_right1")
			end
		end
		self.h_dir = 0
		if self.v_dir == 1 then
			self.pos.y = self.pos.y + RUNNING_SPEED * dt;
			running = true
			if self.facing_left then
				leg_animation = hash("legs_left")
			else
				leg_animation = hash("legs_right")
			end
		elseif self.v_dir == 2 then
			self.pos.y = self.pos.y - RUNNING_SPEED * dt;
			running = true
			if self.facing_left then
				leg_animation = hash("legs_left")
			else
				leg_animation = hash("legs_right")
			end
		end
		self.v_dir = 0
		if self.pos.y < MIN_Y then
			self.pos.y = MIN_Y
		elseif self.pos.y > MAX_Y then
			self.pos.y = MAX_Y
		end
		if self.pos.x < MIN_X then
			self.pos.x = MIN_X
		elseif self.pos.x > MAX_X then
			self.pos.x = MAX_X
		end
		self.pos.z = 0.3*(MAX_Y - self.pos.y)/(MAX_Y-MIN_Y)
		go.set_position(self.pos)
		if self.leg_animation ~= leg_animation then
			self.leg_animation = leg_animation
			sprite.play_flipbook("#legs", leg_animation)
		end
		if self.body_animation ~= body_animation then
			self.body_animation = body_animation
			sprite.play_flipbook("#body", body_animation)
		end

		if self.baton_state == 1 then
			if self.hit_countdown < HIT_START then
				self.baton_state = 2
				msg.post("/cop#left_baton", "enable")
			end
		elseif self.baton_state == 2 then
			if self.hit_countdown < HIT_END then
				self.baton_state = 0
				msg.post("/cop#left_baton", "disable")
			end
		elseif self.baton_state == 3 then
			if self.hit_countdown < HIT_START then
				self.baton_state = 4
				msg.post("/cop#right_baton", "enable")
			end
		elseif self.baton_state == 4 then
			if self.hit_countdown < HIT_END then
				self.baton_state = 0
				msg.post("/cop#right_baton", "disable")
			end
		end
		-- Scroll screen
		local scroll_x = NATURAL_X - self.pos.x
		if scroll_x > 0 then
			scroll_x = 0
		elseif scroll_x < -240.0 then
			scroll_x = -240.0
		end
		go.set_position(vmath.vector3(scroll_x,0,0), "/game_background")
	end
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("activate") then
		setup(self)
	elseif message_id == hash("deactivate") then
		self.active = false
		msg.post(".", "release_input_focus")
	end
end

function on_input(self, action_id, action)
	if action_id == hash("space") then
		if self.hit_countdown <= 0 then
			self.hit_countdown = SWING_INTERVAL
			if self.facing_left then
				self.body_animation = hash("hit_left")
				self.baton_state = 1
			else
				self.body_animation = hash("hit_right")
				self.baton_state = 3
			end
			sprite.play_flipbook("#body", self.body_animation)
		end
	elseif action_id == hash("up") then
		self.v_dir = 1
	elseif action_id == hash("down") then
		self.v_dir = 2
	elseif action_id == hash("left") then
		self.h_dir = 3
	elseif action_id == hash("right") then
		self.h_dir = 4
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
