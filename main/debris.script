go.property("dir", vmath.vector3())
go.property("rotation", 20.0)
go.property("type", 1)

LOOKS = {hash("foot"), hash("tall_hat_black"), hash("woman_hat_black"),
hash("short_hat_black"), hash("dude_hat_black"),
hash("tall_hat_white"), hash("woman_hat_white"),
hash("short_hat_white"), hash("dude_hat_white")}
MOVE_SPEED = 150.0
FADE_SPEED = 2.0
LIFE_SPAN = 0.3

function init(self)
	sprite.play_flipbook("#sprite", LOOKS[self.type])
	self.pos = go.get_position()
	self.alpha = 1.0
	self.counter = LIFE_SPAN
	self.angle = 0.0
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	self.pos.x = self.pos.x + self.dir.x * MOVE_SPEED * dt
	self.pos.y = self.pos.y + self.dir.y * MOVE_SPEED * dt
	self.alpha = self.alpha - dt * FADE_SPEED
	self.counter = self.counter - dt
	self.angle = self.angle + self.rotation * dt
	if self.counter <= 0 then
		go.delete()
	else
		go.set_position(self.pos)
		go.set("#sprite", "tint", vmath.vector4(1, 1, 1, self.alpha))
		go.set_rotation(vmath.quat_rotation_z(math.rad(self.angle)))
	end
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

