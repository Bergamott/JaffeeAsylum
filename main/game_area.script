RELEASE_INTERVAL = 1.5
WALKER_START_X = -20.0
WALKER_MIN_Y = 70
WALKER_MAX_Y = 315
function init(self)
	self.release_timer = RELEASE_INTERVAL
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	self.release_timer = self.release_timer - dt
	if self.release_timer <= 0 then
		local y = math.random(WALKER_MIN_Y,WALKER_MAX_Y)
		local id = factory.create("#walker_factory", vmath.vector3(WALKER_START_X, y, 0.0), nil)
		self.release_timer = self.release_timer + RELEASE_INTERVAL
	end
end

