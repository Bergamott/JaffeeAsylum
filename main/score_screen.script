DIGIT_FRAMES = {hash("0"), hash("1"), hash("2"), hash("3"),
	hash("4"), hash("5"), hash("6"), hash("7"), hash("8"), hash("9")}
SCALE_SPEED = 0.5
local function setup(self)
	sprite.play_flipbook("#text", hash("empty"))
	sprite.play_flipbook("#digit1", hash("0"))
	sprite.play_flipbook("#digit2", hash("0"))
	sprite.play_flipbook("#digit3", hash("0"))
	go.set_position(vmath.vector3(0, 0, 0.5))
	self.scale = 0.001
	go.set_scale(vmath.vector3(self.scale, 1.0, 1.0), "/slider")
	go.set_position(vmath.vector3(76.0+128.0*self.scale, 220.0, 0.15),  "/slider")
	self.state = 1
	sound.play("/sounds#counter")
end

function init(self)
	self.scale = 0.001
	self.score = 0
	self.active = false
	self.delay = 0
	self.state = 0
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	if self.state == 1 then
		if self.scale < self.score*0.01 then
			self.scale = self.scale + dt * SCALE_SPEED
			go.set_scale(vmath.vector3(self.scale, 1.0, 1.0), "/slider")
			go.set_position(vmath.vector3(76.0+128.0*self.scale, 220.0, 0.15),  "/slider")
			local sc = math.min(math.floor(100.0*self.scale+0.5),100.0)
			sprite.play_flipbook("#digit1", DIGIT_FRAMES[1+math.floor(sc/100)])
			sprite.play_flipbook("#digit2", DIGIT_FRAMES[1+(math.floor(sc/10)%10)])
			sprite.play_flipbook("#digit3", DIGIT_FRAMES[1+(math.floor(sc)%10)])
		else
			self.state = 2
			self.delay = 0.2
			sound.stop("/sounds#counter")
		end
	elseif self.state == 2 then
		self.delay = self.delay - dt
		if self.delay <= 0 then
			if self.score >= 80 then
				sprite.play_flipbook("#text", hash("target_met"))
				self.delay = 2.5
				sound.play("/sounds#success")
			else
				sprite.play_flipbook("#text", hash("game_over"))
				self.delay = 3.5
			end
			self.state = 3
		end
	elseif self.state == 3 then
		self.delay = self.delay - dt
		if self.delay <= 0 then
			self.state = 0
			if self.score >= 80 then
				msg.post("/level_screen#level_screen","show", { level = self.level + 1 })
			else
				msg.post("/menu#menu","show")
			end
			-- Hide
			go.set_position(vmath.vector3(0, 0, -2.0))
		end
	end
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("show") then
		self.score = message.score
		self.level = message.level
		setup(self)
	end
end

